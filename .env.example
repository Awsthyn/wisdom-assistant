# Copy to .env and fill in real values. Never commit .env.

# Which provider answers chat and agent requests: gemini | anthropic
LLM_PROVIDER=gemini

# Gemini (always required: embeddings come from Gemini even with LLM_PROVIDER=anthropic)
GEMINI_API_KEY=fake-gemini-api-key
# Use the API model id (e.g. gemini-3.5-flash-lite), not the display name.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# Anthropic (optional; only needed with LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=fake-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-5-5

# Neon Postgres. Pooled URL for the app, direct URL for migrations.
DATABASE_URL=postgresql+asyncpg://user:password@ep-example-pooler.neon.tech/wisdom
DATABASE_URL_DIRECT=postgresql+asyncpg://user:password@ep-example.neon.tech/wisdom

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
