# Copy to .env and fill in real values. Never commit .env.

# Which provider answers chat and agent requests: gemini | anthropic
LLM_PROVIDER=gemini

# Gemini (always required: embeddings come from Gemini even with LLM_PROVIDER=anthropic)
GEMINI_API_KEY=fake-gemini-api-key
# Use the API model id (e.g. gemini-3.5-flash-lite), not the display name.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# Anthropic (optional; only needed with LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=fake-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-5-5

# Embedding ingestion pacing (stay under the free-tier limits of the embeddings model)
EMBED_RPM=80
EMBED_TPM=24000

# Neon Postgres, pasted as Neon shows them (postgresql://...?sslmode=require is fine).
# Pooled URL (host ends in -pooler) for the API; direct URL for migrations and ingestion.
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Integration tests only: a disposable local database (its schema gets dropped)
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54329/wisdom_test

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
